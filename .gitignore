# Secrets / env
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
out/
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Scraper output
# Ignore directory contents but NOT the directory itself, so we can negate
# the two files that Next.js reads at build time (same trick as public/schools/).
scraper/output/*
!scraper/output/schools.jsonl
!scraper/output/schools_enriched.jsonl
scraper/cache/
scraper/.scrapling/
*.jsonl
!scraper/fixtures/*.jsonl
!scraper/output/schools.jsonl
!scraper/output/schools_enriched.jsonl

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Brand audit working files (notes.md is committed; raw HTML/SVG fetches are not)
brand-research/home.html
brand-research/*.css

# Scraped photos cached from Google Places (30-day ToS, refreshed by enrich.py).
# Glob the contents — NOT the directory itself — so we can negate fallback.jpg.
# (git can't re-include a file inside a fully-ignored directory.)
apps/web/public/schools/*
!apps/web/public/schools/fallback.jpg

# Generated SEO content + scrape working files (run scraper to regenerate)
scraper/data/
